# Railway & Production Environment Variables Example
PORT=5000
NODE_ENV=production

# Database Configuration (Using SQLite on Persistent Volume)
# Railway Volume Mount Path (e.g. /app/server)
# Make sure school.db and database.json are stored in a persistent volume.
# No DATABASE_URL is used since the app strictly relies on Better-SQLite3 (local file).

# JWT Secret Key for Authentication Tokens
JWT_SECRET=super_secret_jwt_key_sabil_school_production_2026
JWT_EXPIRES_IN=24h

# Allowed CORS Origins (Comma separated)
CORS_ORIGIN=https://ecole-app.up.railway.app,http://localhost:5173
